{
  "name": "otherbridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "swap:deps": "pnpm --dir swap-providers install --frozen-lockfile --ignore-scripts",
    "dev": "node scripts/next-pinned.mjs dev --hostname 127.0.0.1 --port 3100",
    "dev:test": "node scripts/dev-test.mjs",
    "build": "node scripts/i18n-check.mjs && node scripts/next-pinned.mjs build",
    "start": "node scripts/next-pinned.mjs start --hostname 127.0.0.1 --port 3101",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts services packages swap-providers *.json *.ts *.mjs",
    "format:check": "prettier --check src tests scripts services packages swap-providers *.json *.ts *.mjs",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "verify:safety": "node scripts/verify-safety.mjs",
    "verify:live-readonly": "node scripts/live-probe.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm verify:safety && pnpm build",
    "networks:sync": "node scripts/networks-sync.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "catalog:sync": "vitest run --config scripts/catalog.vitest.config.ts",
    "data:db:init": "node scripts/data-db-init.mjs",
    "data:db:up": "docker compose --env-file .env.data.local -f infra/data/compose.yaml up -d --wait",
    "data:db:stop": "docker compose --env-file .env.data.local -f infra/data/compose.yaml stop",
    "data:db:migrate": "node scripts/data.mjs db:migrate",
    "data:db:status": "node scripts/data.mjs db:status",
    "data:rpc:sync": "node scripts/data.mjs rpc:sync",
    "data:rpc:health": "node scripts/data.mjs rpc:health",
    "data:tokens:sync": "node scripts/data.mjs tokens:sync",
    "data:indexer:once": "node scripts/data.mjs indexer:once",
    "data:indexer:run": "node scripts/data.mjs indexer:run",
    "data:coverage": "node scripts/data.mjs coverage",
    "data:verify-index": "node scripts/data.mjs verify-index",
    "data:retention": "node scripts/data.mjs retention:purge",
    "data:client:create": "node scripts/data.mjs client:create",
    "data:key:create": "node scripts/data.mjs key:create",
    "data:key:revoke": "node scripts/data.mjs key:revoke",
    "data:usage:show": "node scripts/data.mjs usage:show",
    "data:api:dev": "node scripts/data.mjs api",
    "data:verify": "node scripts/data.mjs db:status && node scripts/data.mjs verify-index && node scripts/data.mjs coverage",
    "test:db": "vitest run --config tests/db/vitest.config.ts",
    "data:chains:sync": "node scripts/data.mjs chains:sync",
    "data:indexer:resume": "node scripts/data.mjs indexer:resume",
    "data:indexer:rewitness": "node scripts/data.mjs indexer:rewitness",
    "data:indexer:backfill": "node scripts/data.mjs indexer:backfill",
    "data:rpc:provenance": "node scripts/data.mjs rpc:provenance",
    "data:ops-exporter": "node scripts/data.mjs ops-exporter",
    "data:backup:create": "node scripts/data.mjs backup:create",
    "data:backup:verify": "node scripts/data.mjs backup:verify",
    "data:backup:list": "node scripts/data.mjs backup:list",
    "data:backup:restore-test": "node scripts/data.mjs backup:restore-test",
    "data:backup:corruption-test": "node scripts/data.mjs backup:corruption-test",
    "data:backup:prune": "node scripts/data.mjs backup:prune",
    "data:backup:drill-cleanup": "node scripts/data.mjs backup:drill-cleanup",
    "g7:preserve": "node scripts/g7-preserve.mjs",
    "g7:prepare": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs scripts/g7-prepare.ts",
    "g7:track": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs scripts/g7-track.ts",
    "g7:safety": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs scripts/g7-safety-scan.ts",
    "g7:docs": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs scripts/g7-docs.ts",
    "g7:pilot": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs scripts/g7-pilot.ts",
    "g7:product-pilot": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs scripts/g7-pilot-build.ts --profile local-g7-pilot --if-stale && node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs scripts/g7-product-pilot.ts",
    "g7:product-pilot:build": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs scripts/g7-pilot-build.ts",
    "g7:product-pilot:stop": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs scripts/g7-pilot-stop.ts",
    "g7:artifacts:check": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs scripts/g7-pilot-artifacts.ts",
    "g7:product-pilot:e2e": "playwright test --config tests/g7-pilot/product.playwright.config.ts",
    "g7:pilot:safety": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs scripts/g7-pilot-safety.ts",
    "g7:pilot:e2e": "playwright test --config tests/g7-pilot/playwright.config.ts",
    "g7:dry-acceptance": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs scripts/g7-pilot/dry-acceptance.ts",
    "assets:sync:chains": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs scripts/assets/sync.ts chains",
    "assets:sync:trustwallet": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs scripts/assets/sync.ts trustwallet",
    "assets:sync:routing": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs scripts/assets/sync.ts routing",
    "assets:sync:coingecko": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs scripts/assets/sync.ts coingecko",
    "assets:sync:dexscreener": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs scripts/assets/sync.ts dexscreener",
    "assets:sync:onebridge": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs scripts/assets/onebridge.ts",
    "assets:build": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs scripts/assets/sync.ts build",
    "assets:verify": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs scripts/assets/sync.ts verify",
    "assets:coverage": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs scripts/assets/sync.ts coverage",
    "assets:sync:all": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs scripts/assets/onebridge.ts && node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs scripts/assets/sync.ts all",
    "docs:build": "node scripts/docs-build.mjs",
    "docs:check": "node scripts/docs-build.mjs --check",
    "defi:registry": "node scripts/defi-registry.mjs",
    "defi:sync": "node --env-file=.env.data.local --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs services/defi.ts registry",
    "defi:index": "node --env-file=.env.data.local --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs services/defi.ts index",
    "defi:retention": "node --env-file=.env.data.local --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs services/defi.ts retention",
    "test:defi": "vitest run tests/unit/v113-defi.test.ts tests/integration/v113-defi.test.ts",
    "defi:universe:load": "node --env-file=.env.data.local --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs services/defi.ts universe",
    "defi:universe:report": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs scripts/defi-universe-report.ts",
    "defi:proofs": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs scripts/defi-proofs.ts",
    "defi:universe:sync": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./scripts/ts-hooks.mjs scripts/defi-universe-sync.ts",
    "release:credentials:check": "node scripts/release-command.mjs release-credentials",
    "release:external-gates": "node scripts/release-command.mjs release-external-gates",
    "release:schemas": "node scripts/release-command.mjs release-schemas"
  },
  "dependencies": {
    "@lifi/sdk": "4.10.0",
    "@lifi/types": "18.12.1",
    "@noble/hashes": "2.4.0",
    "@privy-io/react-auth": "3.47.0",
    "@rainbow-me/rainbowkit": "2.2.10",
    "@scure/base": "2.4.0",
    "@stellar/freighter-api": "6.0.1",
    "@tanstack/react-query": "5.104.1",
    "@wallet-standard/app": "1.1.1",
    "get-nonce": "1.0.1",
    "next": "16.4.5",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "saxes": "6.0.0",
    "viem": "2.57.2",
    "wagmi": "2.19.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@ethereumjs/vm": "10.1.3",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.9",
    "solc": "0.8.37",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
