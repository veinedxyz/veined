{
  "name": "otherbridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "dev:test": "node scripts/dev-test.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3101",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts *.json *.ts *.mjs",
    "format:check": "prettier --check src tests scripts *.json *.ts *.mjs",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "verify:safety": "node scripts/verify-safety.mjs",
    "verify:live-readonly": "node scripts/live-probe.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm verify:safety && pnpm build"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.57.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@ethereumjs/vm": "10.1.3",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "solc": "0.8.37",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
