    "concepts": [
      {
        "id": "a-vein-nexus",
        "name": "VEIN NEXUS",
        "scores": [
          8,
          10,
          8,
          7,
          8,
          8,
          8,
          9,
          8,
          8
        ],
        "total": 82,
        "rationale": "Eight routes converge on a quiet, open nucleus. Curved branches connect organic vein structure with precise network coordination.",
        "construction": "Eight open cubic route paths; one closed four-lobed nucleus with an open central counter. Branches are intentionally free of terminal dots."
      },
      {
        "id": "b-mantle-graph",
        "name": "MANTLE GRAPH",
        "scores": [
          8,
          9,
          9,
          6,
          9,
          7,
          9,
          9,
          8,
          9
        ],
        "total": 83,
        "rationale": "A calm mantle is cut by seven rising channels, leaving eight implied extensions. A solid, architectural silhouette, without eyes or illustrated tentacles.",
        "construction": "One pointed mantle silhouette with a flared lower edge; seven rising negative-space channels imply exactly eight extensions. The pointed upper contour avoids a cartoon head."
      },
      {
        "id": "c-quiet-current",
        "name": "QUIET CURRENT",
        "scores": [
          9,
          9,
          10,
          9,
          10,
          10,
          10,
          10,
          9,
          9
        ],
        "total": 95,
        "rationale": "Two inbound currents merge into one continuous V. An open incision at the shoulder makes the junction visible; a rounded bend releases into a rising, tapered route.",
        "construction": "One closed cubic silhouette with an open shoulder incision; no strokes, masks, overlap or filters. Two inbound branches join below the incision; the rising terminal balances the broad lower bend."
      }
    ]
  },
