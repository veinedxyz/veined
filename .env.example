OTHERBRIDGE_MODE=mainnet-readonly
OTHERBRIDGE_ENABLE_MAINNET_SUBMISSION=false
# No private keys, seed phrases, borrowed project IDs or arbitrary RPC URLs.
# V1.4 self-hosted data plane (all optional for local UI; no defaults, no secrets here).
# Local values are generated into the git-ignored .env.data.local by `pnpm data:db:init`.
# OTHERBRIDGE_DATA_DATABASE_URL=        # app/data-api role (postgres://...); absent => DEGRADED registry snapshot
# OTHERBRIDGE_DATA_INDEXER_URL=         # indexer role (workers only)
# OTHERBRIDGE_DATA_MIGRATOR_URL=        # migrator role (migrations/admin CLI only)
# OTHERBRIDGE_DATA_PSEUDONYM_KEY=       # >=32 chars; required for public deployments
# OTHERBRIDGE_RATE_LIMIT_BACKEND=       # memory | postgres (postgres requires DATABASE_URL)
# OTHERBRIDGE_REQUIRE_DURABLE_RATE_LIMIT=false
# OTHERBRIDGE_PUBLIC_DEPLOYMENT=false   # true => production requires postgres limiter + pseudonym key
# OTHERBRIDGE_APP_ORIGINS=              # exact comma-separated origins (https only, no wildcard); empty => loopback dev/preview
# OTHERBRIDGE_TRUST_PROXY_HOPS=0        # 0-3; forwarded headers are ignored unless set
# OTHERBRIDGE_DATA_API_PORT=3200        # loopback developer API (not launched)
# OTHERBRIDGE_DATA_LOG=on               # structured redacted logs (on|off)
# The paid portfolio credential OTHERBRIDGE_PORTFOLIO_API_KEY was retired in V1.4 and is not read.
# V1.9 Privy external-wallet layer (connect-only). Public 25-character App ID from the Privy dashboard
# (Configuration > App settings > Basics); put the real value only in the git-ignored .env.local.
# Without it the product stays read-only and "Connect wallet" reports that wallet connection is unavailable.
# NEXT_PUBLIC_PRIVY_APP_ID=
