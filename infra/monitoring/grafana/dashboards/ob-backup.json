{
  "uid": "ob-backup",
  "title": "Otherbridge — Backup and restore",
  "tags": [
    "otherbridge",
    "v1.5"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 39,
      "title": "Hours since last successful backup",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "otherbridge-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min((time() - max(otherbridge_backup_last_success_timestamp_seconds{kind=\"BACKUP\"})) / 3600, 0)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "otherbridge-prometheus"
          }
        }
      ]
    },
    {
      "id": 40,
      "title": "Hours since last restore drill",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "otherbridge-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min((time() - max(otherbridge_backup_last_success_timestamp_seconds{kind=\"RESTORE_DRILL\"})) / 3600, 0)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "otherbridge-prometheus"
          }
        }
      ]
    },
    {
      "id": 41,
      "title": "Last backup failure (unix)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "otherbridge-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(otherbridge_backup_last_failure_timestamp_seconds{kind=\"BACKUP\"}) or vector(0)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "otherbridge-prometheus"
          }
        }
      ]
    },
    {
      "id": 42,
      "title": "Backup events",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "otherbridge-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "otherbridge_backup_events",
          "legendFormat": "{{kind}} ok={{ok}}",
          "datasource": {
            "type": "prometheus",
            "uid": "otherbridge-prometheus"
          }
        }
      ]
    }
  ]
}
