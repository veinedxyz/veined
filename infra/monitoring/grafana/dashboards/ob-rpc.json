      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "otherbridge-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (otherbridge_rpc_endpoint_quarantined)",
          "legendFormat": "{{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "otherbridge-prometheus"
          }
        }
      ]
    },
    {
      "id": 23,
      "title": "Chain-ID / log mismatch quarantines",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "otherbridge-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "otherbridge_rpc_chain_id_mismatch_quarantines + otherbridge_rpc_log_mismatch_quarantines",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "otherbridge-prometheus"
          }
        }
      ]
    },
    {
