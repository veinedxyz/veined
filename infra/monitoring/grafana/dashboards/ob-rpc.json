{
  "uid": "ob-rpc",
  "title": "Otherbridge — RPC health",
  "tags": [
    "otherbridge",
    "v1.5"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 18,
      "title": "Healthy endpoints per chain",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "otherbridge-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "otherbridge_rpc_healthy_endpoints",
          "legendFormat": "{{chain}}",
          "datasource": {
            "type": "prometheus",
            "uid": "otherbridge-prometheus"
          }
        }
      ]
    },
    {
      "id": 19,
      "title": "Independent witness operators per chain",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "otherbridge-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
