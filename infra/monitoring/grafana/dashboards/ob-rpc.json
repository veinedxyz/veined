      "datasource": {
        "type": "prometheus",
        "uid": "otherbridge-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "otherbridge_rpc_endpoint_error_rate{chain=~\"42161|43114|57073|480\"}",
          "legendFormat": "{{endpoint}}",
          "datasource": {
            "type": "prometheus",
            "uid": "otherbridge-prometheus"
          }
        }
      ]
    },
    {
      "id": 22,
