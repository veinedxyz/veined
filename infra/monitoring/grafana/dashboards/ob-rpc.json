      "datasource": {
        "type": "prometheus",
        "uid": "otherbridge-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "otherbridge_rpc_endpoint_latency_ms{chain=~\"42161|43114|57073|480\"}",
